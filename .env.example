# Vercel and local commands connect to the same PostgreSQL database.
# Production: use Coolify's externally reachable PostgreSQL hostname, with TLS.
DATABASE_URL=postgresql://mam_nho:CHANGE_ME@db.example.com:5432/mam_nho?sslmode=verify-full
DATABASE_POOL_MAX=3
# Optional PEM CA for a private certificate authority (literal \n supported).
# When using DATABASE_SSL_CA, omit sslmode/sslrootcert from DATABASE_URL.
DATABASE_SSL_CA=
# Required by db:setup when creating the first production teacher (12+ characters).
TEACHER_PASSWORD=
TEACHER_NAME=Cô Minh Anh
TEACHER_EMAIL=giaovien@mamnho.vn
# Public website origin, with no trailing slash.
APP_ORIGIN=https://your-project.vercel.app
VAPID_SUBJECT=mailto:teacher@example.com
# Optional existing key pair; otherwise db:setup persists generated keys in PostgreSQL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
